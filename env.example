# DSA Coach - Environment Configuration
# =====================================
# Copy this file to .env and add your API keys
#
# Usage:
#   cp env.example .env
#   Then edit .env with your actual keys

# Choose your LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic API Key (for Claude)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (for GPT-4)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Obsidian Vault Path (for atomic notes)
# Complete path to your DSA-Prep folder in Obsidian
# Example: /Users/you/Documents/Obsidian Vault/02 Areas/DSA-Prep
OBSIDIAN_VAULT_PATH=

